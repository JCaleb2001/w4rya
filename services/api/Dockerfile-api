FROM python:3.10

COPY ./requirements.txt /app/requirements.txt

WORKDIR /app

RUN pip install -r requirements.txt

# The vulnbox module shells out to ssh, ssh-keygen and git. The full
# python:3.10 image ships them (buildpack-deps); fail the build loudly if a
# slimmer base image ever drops them, instead of at the first button press.
RUN command -v ssh && command -v ssh-keygen && command -v git

COPY . /app

STOPSIGNAL SIGINT

CMD ["gunicorn", "-w", "3", "-t", "60", "--log-level", "info", "--capture-output", "--enable-stdio-inheritance", "-b", "0.0.0.0:5000", "webservice:create_app()"]
