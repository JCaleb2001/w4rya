##############################
# w4rya config
##############################

# Timescale connection
TIMESCALE="postgres://w4rya@timescale:5432/w4rya"

# Session signing secret for auth cookies. Generate with: openssl rand -hex 32
# REQUIRED — the api refuses to start without it.
# ./install.sh fills this in for you, and keeps an existing value on re-runs.
W4RYA_SECRET_KEY=

# Set to 1 only when the api is served behind HTTPS (TLS terminator,
# reverse proxy, etc). Forces the session cookie to be sent over TLS only.
# Default empty/0 = ok for local dev or LAN-only deployments.
W4RYA_COOKIE_SECURE=

# api log level — INFO is the default; bump to DEBUG when troubleshooting
# (very chatty: gunicorn logs every request).
W4RYA_LOG_LEVEL=INFO

# The location of your pcaps as seen by the host
TRAFFIC_DIR_HOST="./services/test_pcap"

# The location of your pcaps (and eve.json), as seen by the container
TRAFFIC_DIR_DOCKER="/traffic"

# Set BPF filter expression (see https://www.tcpdump.org/manpages/pcap-filter.7.html)
#BPF="port 8080"

# Visualizer
#VISUALIZER_URL="http://scraper.example.com"

##############################
# Game config
##############################

# Start time of the CTF (or network open if you prefer)
TICK_START="2024-11-30T13:00:00Z"

# Tick length in ms
TICK_LENGTH=180000

# The flag format in regex
FLAG_REGEX="[A-Z0-9]{31}="

# VM IP (inside gamenet)
# Currently ignored unless FLAGID_SCRAPE is set
VM_IP="10.10.3.1"
TEAM_ID="3"

##############################
# PCAP_OVER_IP CONFIGS
##############################

# Enable pcap-over-ip and choose server endpoint
# Empty value = disabled
PCAP_OVER_IP=
#PCAP_OVER_IP="host.docker.internal:1337"
# For multiple PCAP_OVER_IP you can comma separate
#PCAP_OVER_IP="host.docker.internal:1337,otherhost.com:5050"

##############################
# DUMP_PCAPS CONFIGS
##############################

# Enable pcap dumping and select target location
# Empty value = disabled
DUMP_PCAPS=
#DUMP_PCAPS="/traffic"

# Dumping options
# Ignored unless DUMP_PCAPS is set
DUMP_PCAPS_INTERVAL="1m"
DUMP_PCAPS_FILENAME="2006-01-02_15-04-05.pcap"

##############################
# FLAGID CONFIGS
##############################

# Enable flagid scrapping
# Empty value = disabled
FLAGID_SCRAPE=
#FLAGID_SCRAPE=1

# Enable flagid scanning - Tags flag ids in traffic
# Empty value = disabled
# Does nothing unless FLAGID_SCRAPE is set
FLAGID_SCAN=
#FLAGID_SCAN=1

# Flag lifetime in ticks
# Empty value = Fallback to TICK_LENGTH
# -1 = No check, pls don't use outside testing
FLAG_LIFETIME=
#FLAG_LIFETIME=-1
#FLAG_LIFETIME=5

# Flagid endpoint — your CTF platform's flagids JSON (Faust, EnoEngine, etc).
# Ignored unless FLAGID_SCRAPE is set.
FLAGID_ENDPOINT="http://scoreboard.example.com/flagids.json"

##############################
# FLAG_VALIDATOR CONFIGS
##############################

# Enables flag validation / fake flag feature. Must be one of: faust, enowars, eno, itad
# Empty value = disabled
FLAG_VALIDATOR_TYPE=

# Some flag validators can make use of (our) team number/ID
# Ignored unless FLAG_VALIDATOR_TYPE is set
FLAG_VALIDATOR_TEAM=42

##############################
# SURICATA CONFIGS
##############################

# Directory for Suricata files (suricata/etc, suricata/lib/rules,
# suricata/logs). Only used by docker-compose-suricata.yml.
# The subdirs are NOT created automatically — `./install.sh --suricata` makes
# them as your user. If you create the stack by hand without them, Docker
# invents them root-owned and Suricata starts with no config and no rules.
SURICATA_DIR_HOST="./suricata"

##############################
# Managed by install.sh
##############################

# Which compose file this install uses. install.sh --check, scripts/smoke.sh
# and scripts/backup.sh all read it from here, so the whole toolchain agrees on
# one stack. The two compose files cannot run at the same time: they share
# service names, image tags, the volume and the project name.
W4RYA_COMPOSE_FILE=docker-compose.yml

# Host port the UI is published on. Change it if 3001 is taken.
W4RYA_UI_PORT=3001
