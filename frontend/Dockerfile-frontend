FROM node:17

COPY package.json /app/
COPY yarn.lock /app/

WORKDIR /app

# yarn 1.x gives up on a tarball after 30s of socket silence. Building the six
# services in parallel starves a slow link well past that, so the default blows
# up with ESOCKETTIMEDOUT on whichever package happens to be unlucky. Ten
# minutes of patience and fewer concurrent sockets instead.
RUN yarn install --frozen-lockfile --network-timeout 600000 --network-concurrency 4

COPY . /app/

RUN yarn run build

EXPOSE 3000

CMD ["yarn", "run", "preview", "--host", "--port", "3000"]
